# .env.example · 复制为 .env 并填入真实值
# TokenTruth · Monad Testnet

# 链模式：mock（默认） / live
TOKENTRUTH_CHAIN_MODE=mock

# Monad Testnet RPC
MONAD_RPC=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER=https://testnet.monadexplorer.com

# 部署者私钥（仅 live 模式需要；演示用 mock 时不要填）
PRIVATE_KEY=

# 部署后从 deploy.py 输出的合约地址填入
DISCLOSURE_REGISTRY_ADDRESS=

# 端口
PORT=4000
FLASK_DEBUG=1
